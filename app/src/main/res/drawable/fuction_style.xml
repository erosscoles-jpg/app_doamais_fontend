<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Grossura e cor da borda -->
    <stroke
        android:width="2dp"
        android:color="#FFFF"
        /> <!-- Exemplo: Borda Laranja -->

    <!-- Arredondamento dos cantos (opcional) -->
    <corners android:radius="15dp" />
    <solid android:color="#33FFFFFF" />

    <!-- Margem interna (Padding opcional) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>