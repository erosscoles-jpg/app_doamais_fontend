                    android:id="@+id/textView26"
                    android:layout_width="336dp"
                    android:layout_height="163dp"
                    android:text="Minhas campanhas de doação de sangue disponiveis"
                    android:textColor="#FFFFFF"
                    android:textSize="38dp"
