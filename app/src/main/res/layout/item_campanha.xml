<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="326dp"
        android:padding="16dp"
        android:background="@drawable/borda_campanha">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/txtTituloCampanha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nome da campanha"
            android:textColor="#000000"
            android:textSize="26sp"
            app:layout_constraintEnd_toStartOf="@id/txtStatusCampanha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- STATUS -->
        <TextView
            android:id="@+id/txtStatusCampanha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Pendente"
            android:textColor="#000000"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- DATA -->
        <ImageView
            android:id="@+id/imgDataCampanha"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Data da campanha"
            app:srcCompat="@drawable/baseline_calendar_month_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtDataCampanha"
            app:layout_constraintBottom_toBottomOf="@id/txtDataCampanha" />

        <TextView
            android:id="@+id/txtDataCampanha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="24dp"
            android:text="15 de Dezembro de 2026"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgDataCampanha"
            app:layout_constraintTop_toBottomOf="@id/txtTituloCampanha" />

        <!-- HORÁRIO -->
        <ImageView
            android:id="@+id/imgHorarioCampanha"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Horário da campanha"
            app:srcCompat="@drawable/sharp_clock_loader_90_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtHorarioCampanha"
            app:layout_constraintBottom_toBottomOf="@id/txtHorarioCampanha" />

        <TextView
            android:id="@+id/txtHorarioCampanha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp"
            android:text="08:00"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgHorarioCampanha"
            app:layout_constraintTop_toBottomOf="@id/txtDataCampanha" />

        <!-- LOCAL -->
        <ImageView
            android:id="@+id/imgLocalCampanha"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Local da campanha"
            app:srcCompat="@drawable/sharp_add_location_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtLocalCampanha"
            app:layout_constraintBottom_toBottomOf="@id/txtLocalCampanha" />

        <TextView
            android:id="@+id/txtLocalCampanha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp"
            android:text="Hospital Central"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgLocalCampanha"
            app:layout_constraintTop_toBottomOf="@id/txtHorarioCampanha" />

        <!-- BOTÃO DE LEMBRETE -->
        <Button
            android:id="@+id/btnLembreteCampanha"
            android:layout_width="0dp"
            android:layout_height="51dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#009688"
            android:text="Marcar lembrete"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtLocalCampanha"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>