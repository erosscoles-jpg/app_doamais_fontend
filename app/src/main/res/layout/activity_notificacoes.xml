<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".NotificacoesActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- VOLTAR -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/outline_arrow_left_alt_24"
                android:drawablePadding="6dp"
                android:padding="0dp"
                android:text="Voltar"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:gravity="center_vertical"/>

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/textView48"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Minhas Notificações"
                android:textColor="#000000"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- SUBTÍTULO -->
            <TextView
                android:id="@+id/textView51"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gerencie seus lembretes de campanhas"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- NOTIFICAÇÕES ATIVAS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNotificacoesAtivas"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#F8F8F8"
                app:cardCornerRadius="9dp"
                app:cardElevation="2dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:id="@+id/textView52"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Notificações Ativas"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/textView53"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView53"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>


            <!-- ANTECEDÊNCIA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAntecedencia"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#F8F8F8"
                app:cardCornerRadius="9dp"
                app:cardElevation="2dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="20dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@+id/textView54"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Antecedência"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/textView55"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView55"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 dias"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>


            <!-- CONFIGURAÇÕES DE NOTIFICAÇÕES -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardConfiguracoesNotificacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#F8F8F8"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- TÍTULO -->
                    <TextView
                        android:id="@+id/textView56"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Configurações de Notificações"
                        android:textColor="#111111"
                        android:textSize="20sp"
                        android:textStyle="normal" />

                    <!-- DESCRIÇÃO -->
                    <TextView
                        android:id="@+id/textView57"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Configure como você deseja receber os lembretes das campanhas"
                        android:textColor="#222222"
                        android:textSize="16sp" />


                    <!-- WHATSAPP -->
                    <TextView
                        android:id="@+id/textView58"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Notificações via WhatsApp"
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/textView59"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Receba lembretes no WhatsApp sobre sua doação de sangue."
                            android:textColor="#222222"
                            android:textSize="16sp" />

                        <Switch
                            android:id="@+id/switch2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>


                    <!-- E-MAIL -->
                    <TextView
                        android:id="@+id/textView60"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Notificações via E-mail"
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView61"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Receba lembretes por e-mail"
                            android:textColor="#222222"
                            android:textSize="16sp" />

                        <Switch
                            android:id="@+id/switch3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>


                    <!-- ANTECEDÊNCIA -->
                    <TextView
                        android:id="@+id/textView62"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Dias de Antecedência"
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Escolha quantos dias antes deseja receber os lembretes."
                        android:textColor="#222222"
                        android:textSize="16sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- INFORMAÇÕES SOBRE WHATSAPP -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAjudaWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#00645A"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- ÍCONE -->
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="☏"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:gravity="center"/>

                    <!-- TEXTO INFORMATIVO -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Como funciona os lembretes via WhatsApp?\n• Você receberá uma mensagem automática com as informações da campanha\n• O lembrete será enviado de acordo com sua preferência de antecedência\n• Você pode ativar ou desativar os lembretes a qualquer momento\n• Mantenha seu número de WhatsApp atualizado no cadastro"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>