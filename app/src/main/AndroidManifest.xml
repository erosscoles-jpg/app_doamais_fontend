<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DOEMAISUI01">

        <!-- Tela inicial -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de campanhas -->
        <activity
            android:name=".Campanhas"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard do funcionário -->
        <activity
            android:name=".dashboradFuncionario"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Informações -->
        <activity
            android:name=".information"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Perfil do usuário -->
        <activity
            android:name=".meuPerfil"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lista de voluntários -->
        <activity
            android:name=".lista_voluntarios"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Cadastro de voluntários -->
        <activity
            android:name=".cadastroDeVoluntarios"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Criar conta -->
        <activity
            android:name=".criar_conta2"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Nova senha -->
        <activity
            android:name=".NovaSenha"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>